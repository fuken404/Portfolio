# Copia este archivo como .env y ajusta los valores.
DEBUG=True
SECRET_KEY=cambia-esto
# Local (docker compose up -d):
DATABASE_URL=postgres://portafolio:portafolio@127.0.0.1:5435/portafolio
# Producción, por ejemplo Neon o Supabase:
# DATABASE_URL=postgres://usuario:clave@host:5432/portafolio?sslmode=require
# ALLOWED_HOSTS=tudominio.dev
# CORS_ALLOWED_ORIGINS=https://tudominio.dev
